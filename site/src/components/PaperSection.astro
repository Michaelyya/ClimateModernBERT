---
import { project } from "../data/project";
---
<!--
  Deliberately minimal: the hero already carries the byline, the summary and
  the download buttons, so this section adds only what it alone provides —
  the identifier, the scope caveats, and something to paste into a .bib file.
-->
<section class="section section--sunken" id="paper">
  <div class="wrap paper">
    <div>
      <p class="eyebrow">Paper</p>
      <h2 class="paper__title">{project.paperTitle}</h2>
      <p class="paper__status">
        <span class="badge badge--accent">Preprint</span>
        <a class="paper__id" href={project.links.arxivAbs} rel="noopener">arXiv:{project.arxiv.id}</a>
        <span>Submitted {project.arxiv.submitted}.</span>
      </p>

      <div class="cite">
        <div class="cite__head">
          <h3>Cite this work</h3>
          <button class="cite__copy" id="cite-copy" type="button" data-bibtex={project.bibtex}>
            Copy BibTeX
          </button>
        </div>
        <pre><code>{project.bibtex}</code></pre>
      </div>
    </div>

    <aside class="paper__side">
      <h3>Scope</h3>
      <ul>
        <li>English only, one encoder family (ModernBERT-Base).</li>
        <li>Benchmarks are passage-level, so long-context capacity is not fully exercised.</li>
        <li>Findings are demonstrated within climate NLP, not as universal principles.</li>
      </ul>
    </aside>
  </div>
</section>

<style>
  .paper { display: grid; gap: 2rem; }
  @media (min-width: 900px) { .paper { grid-template-columns: 1.7fr 1fr; } }
  .paper > * { min-width: 0; }

  .paper__title {
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 3.2vw, 1.95rem);
    line-height: 1.25; letter-spacing: -.015em; font-weight: 600; margin-bottom: 1rem;
  }
  /* No rule underneath — .cite carries the only divider in this column now. */
  .paper__status {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: .55rem;
    font-size: .8125rem; color: var(--fg-muted); margin: 0;
  }
  .paper__id {
    font-family: var(--font-mono); font-size: .8125rem;
    color: var(--accent); text-decoration: none;
    border-bottom: 1px solid var(--accent-line);
  }
  .paper__id:hover { border-bottom-color: var(--accent); }

  .paper__side {
    background: var(--bg-raised); border: 1px solid var(--line);
    border-radius: var(--radius-lg); padding: 1.35rem; align-self: start;
  }
  .paper__side h3 { font-size: .875rem; margin-bottom: .6rem; }
  .paper__side ul { margin: 0; padding-left: 1.1rem; font-size: .8125rem; color: var(--fg-muted); display: grid; gap: .45rem; }

  .cite { margin-top: 1.75rem; padding-top: 1.5rem; border-top: 1px solid var(--line); }
  .cite__head {
    display: flex; align-items: center; justify-content: space-between;
    gap: 1rem; margin-bottom: .7rem;
  }
  .cite__head h3 { font-size: .875rem; margin: 0; }
  .cite__copy {
    font: inherit; font-size: .75rem; font-weight: 600;
    color: var(--fg-muted); background: var(--bg-raised);
    border: 1px solid var(--line-strong); border-radius: 999px;
    padding: .3rem .7rem; cursor: pointer;
    transition: border-color .15s, color .15s;
  }
  .cite__copy:hover { border-color: var(--accent); color: var(--accent); }
  .cite pre { font-size: .75rem; line-height: 1.6; }
</style>

<script>
  const btn = document.getElementById("cite-copy") as HTMLButtonElement | null;
  const bibtex = btn?.dataset.bibtex ?? "";

  // The <pre> stays the source of truth on failure — readers can always select it.
  btn?.addEventListener("click", async () => {
    const restore = btn.textContent;
    try {
      await navigator.clipboard.writeText(bibtex);
      btn.textContent = "Copied";
    } catch {
      btn.textContent = "Press ⌘C to copy";
    }
    setTimeout(() => { btn.textContent = restore; }, 1800);
  });
</script>
